---
import { getCollection, render } from 'astro:content';
import EditorialEntry from '../../components/EditorialEntry.astro';

export async function getStaticPaths() {
  const people = await getCollection('pessoas', ({ data }) => !data.draft);
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);
---
<EditorialEntry title={person.data.name} eyebrow={`${person.data.lifespan ?? 'Perfil'} · ${person.data.role}`} description={person.data.description} sourceUrl={person.data.sourceUrl}>
  <Content />
</EditorialEntry>
