---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const themes = (await getCollection('temas', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'pt-BR'));
---
<BaseLayout title="Temas" description="Dossiês temáticos sobre política externa, Presidência e relações entre Nixon e o Brasil.">
  <section class="page-hero light"><div class="shell"><p class="kicker">Dossiês</p><h1>Temas</h1><p>Portas de entrada para documentos, pessoas e artigos relacionados.</p></div></section>
  <section class="section"><div class="shell cards">
    {themes.map((theme) => <a class="card text-card" href={`${base}temas/${theme.id}/`}><div class="card-body"><span class="card-meta">Dossiê temático</span><h2>{theme.data.title}</h2><p>{theme.data.description}</p></div></a>)}
  </div></section>
</BaseLayout>
